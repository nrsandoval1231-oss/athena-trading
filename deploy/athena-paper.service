[Unit]
Description=Athena active paper trading supervisor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=athena
Group=athena
WorkingDirectory=/opt/athena-trading
EnvironmentFile=/etc/athena/paper.env
Environment=PYTHONUNBUFFERED=1
Environment=ATHENA_STATE_DIR=/var/lib/athena
ExecStart=/opt/athena-trading/.venv/bin/python -m athena_trading.paper.cloud
Restart=always
RestartSec=30
KillMode=mixed
TimeoutStopSec=210
StateDirectory=athena
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/athena
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
