[Unit]
Description=Athena earnings adaptive paper book
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=athena
Group=athena
WorkingDirectory=/opt/athena-trading
EnvironmentFile=/etc/athena/earnings.env
Environment=PYTHONUNBUFFERED=1
Environment=ATHENA_EARNINGS_STATE_DIR=/var/lib/athena-earnings
ExecStart=/opt/athena-trading/.venv/bin/python -m athena_trading.paper.earnings_cloud
Restart=always
RestartSec=30
KillMode=mixed
TimeoutStopSec=60
StateDirectory=athena-earnings
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/athena-earnings
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
