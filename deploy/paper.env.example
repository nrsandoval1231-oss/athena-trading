# Store the real file at /etc/athena/paper.env with mode 0600, owned by root.
# Supply keys through the deployment's secure secret setup; never commit them.
ALPACA_API_KEY=
ALPACA_API_SECRET=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Explicitly select the intended US equity before enabling the service.
ATHENA_SYMBOL=
ATHENA_FEED=iex
