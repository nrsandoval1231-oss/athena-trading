# Store the real file at /etc/athena/paper.env with mode 0600, owned by root.
# Supply keys through the deployment's secure secret setup; never commit them.
ALPACA_API_KEY=
ALPACA_API_SECRET=
TYPESAFE_API_KEY=
# Explicitly select the intended US equity before enabling the one-trade pilot.
ATHENA_SYMBOL=
ATHENA_FEED=iex
# Leave unset (or set pilot) for the one-trade ORB runner. high-frequency is the
# opt-in paper cadence. Do not run both profiles against the same account.
# ATHENA_PAPER_PROFILE=pilot
# ATHENA_PAPER_PROFILE=high-frequency
# Optional high-frequency universe, 4 to 12 names. Default is the eight below.
# ATHENA_HF_SYMBOLS=SPY,QQQ,IWM,DIA,AAPL,MSFT,NVDA,AMZN
# Optional concurrency, 1 to 4. The cap cannot be raised.
# ATHENA_HF_MAX_CONCURRENT=4
# off (default) does not call Jev. advisory journals a bypass and still does not call Jev.
# ATHENA_HF_JEV=off
# Required for new entries. Both arms on one host must use this same absolute path.
ATHENA_SHARED_RISK_DIR=/var/lib/athena-risk
# Optional paper gate. Unset uses p(TAKE_TRADE) >= 0.6 and confidence >= 0.5.
# ATHENA_JEV_MIN_PTAKE=0.6
# ATHENA_JEV_MIN_CONFIDENCE=0.5
# Minutes after the open with no reserved order before the one daily TAKE_TRADE fallback.
# ATHENA_FALLBACK_AFTER_OPEN_MINUTES=120
# Set when the earnings book shares this paper account. The intraday runner ignores
# positions listed in that directory's ownership.json and orders prefixed athe-.
# ATHENA_EARNINGS_STATE_DIR=/var/lib/athena-earnings
